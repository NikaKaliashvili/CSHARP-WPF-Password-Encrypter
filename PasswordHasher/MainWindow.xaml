<Window x:Class="PasswordEncrypter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordEncrypter"
        mc:Ignorable="d"
        Title="C# Password Encrypter" Height="800" Width="1000" WindowStyle="None">
    <Border BorderThickness="5" BorderBrush="#202640" CornerRadius="10">
        <Grid Background="#202640" MouseLeftButtonDown="Grid_MouseLeftButtonDown">

            <Button Width="50" Height="45" BorderThickness="0" FontSize="25" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Background="Transparent" Foreground="White" PreviewMouseLeftButtonDown="Button_Click">X</Button>

            <Border CornerRadius="5" BorderThickness="4" BorderBrush="AliceBlue" Width="850" Height="600">
                <Grid Width="850" Height="600">
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FF557280"/>
                            <GradientStop Color="#FF202641" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <TextBlock HorizontalAlignment="Center" Margin="15" FontSize="30" Height="40" VerticalAlignment="Top" Foreground="White" FontFamily="Arial" Text="Password Encrypter Tool"/>
                    <Border BorderThickness="5" BorderBrush="AliceBlue" Width="600" Height="50" CornerRadius="5" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="80">

                        <TextBox Width="600" Height="50"  Name="PasswordBox" Padding="5" FontSize="23" Background="#293547" Foreground="White" FontFamily="Cascadia Code" BorderThickness="0" BorderBrush="White">Enter plain text</TextBox>
                    </Border>
                    <TextBlock HorizontalAlignment="Left" Margin="100,150" FontSize="25" FontWeight="Bold" Height="40" VerticalAlignment="Top" Foreground="White" FontFamily="Bahnschrift">Selected Algorithm</TextBlock>
                    <ComboBox Width="600" Height="50" Name="AlgorithmCombo" VerticalAlignment="Top" Margin="0,190" FontSize="25" BorderBrush="White" FontFamily="Bahnschrift" HorizontalAlignment="Center" >
                        <ComboBoxItem Content="Custom" IsSelected="True" Foreground="Black"></ComboBoxItem>
                    </ComboBox>

                    <Button Width="600" Height="50" Name="HashButton" VerticalAlignment="Top" Margin="0,260" FontSize="30" Background="#FF6D9ABF" Foreground="White" FontFamily="Cascadia Mono SemiBold" Click="Button_Click_1" >Encrypt</Button>
                    <TextBlock HorizontalAlignment="Left" Margin="100,225" FontSize="25" FontWeight="Bold" Height="40" VerticalAlignment="Bottom" Foreground="White" FontFamily="Bahnschrift" Text="Output"/>

                    <Border BorderThickness="2" BorderBrush="White" Width="600" Height="60" Margin="0,160" VerticalAlignment="Bottom">
                        <TextBox Width="600" Height="50" Name="EncryptedResult" Background="#293547" Foreground="White" VerticalAlignment="Bottom" FontSize="24" Margin="0,3" BorderThickness="0" FontFamily="Lucida Sans">...</TextBox>
                    </Border>
                    <TextBlock HorizontalAlignment="Left" Margin="100,0,0,97" FontSize="25" FontWeight="Bold" Height="40" VerticalAlignment="Bottom" Foreground="White" FontFamily="Bahnschrift" Text="Decrypt"/>
                    <TextBox HorizontalAlignment="Left" Margin="125,508,0,0" Name="DecryptField"  TextWrapping="Wrap" Text="Enter encrypted text" VerticalAlignment="Top" Width="540" Height="50" FontSize="24"/>
                    <Border BorderThickness="4" BorderBrush="White" Height="50" Margin="665,508,113,42">
                        <Button Content="Decrypt" Name="DecryptButton" HorizontalAlignment="Center" VerticalAlignment="Top" Height="45" Width="68" Background="#FF293547" Foreground="White" FontFamily="Bahnschrift SemiBold" FontSize="16" Click="VerifyButton_Click"/>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
